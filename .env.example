# =====================================================================
# HealthSecure: Environment Configuration Template
# Copy this file to .env and customize values for your environment.
# =====================================================================

# Flask application settings
SECRET_KEY=replace-with-a-long-random-secret
BENEFIT_FACTOR=1.2

# MySQL connection settings
MYSQL_CONNECTION_NAME=Health_Project
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=health_insurance_db

# Alternatively, use one SQLAlchemy URL instead of MYSQL_* variables:
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@127.0.0.1:3306/health_insurance_db

# ---------------------------------------------------------------------
# SMTP Email Configuration (For Email Prediction Reports)
# ---------------------------------------------------------------------
# Examples:
# Gmail:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#   MAIL_USERNAME=your-email@gmail.com
#   MAIL_PASSWORD=your-gmail-16-char-app-password
#   MAIL_DEFAULT_SENDER="HealthSecure AI <your-email@gmail.com>"
#
# Outlook / Office365:
#   MAIL_SERVER=smtp.office365.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#
# Mailtrap (Development testing):
#   MAIL_SERVER=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USE_TLS=True
# ---------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="HealthSecure AI <noreply@healthsecure.com>"

# Google OAuth Client ID (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=
